        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Transaction"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "get": {
        "tags": [
          "Streetpay.API"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/transactions/pending": {
      "get": {
        "tags": [
          "Streetpay.API"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/users/by-phone/{phone}": {
      "get": {
        "tags": [
          "Streetpay.API"
        ],
        "parameters": [
          {
            "name": "phone",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/transactions/send": {
      "post": {
        "tags": [
          "Streetpay.API"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OnlineTransactionDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/transactions/receive-offline": {
      "post": {
        "tags": [
          "Streetpay.API"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OfflineTransactionDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/transactions/sync": {
      "post": {
        "tags": [
          "Streetpay.API"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/OfflineTransactionDto"
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/transactions/history/{userId}": {
      "get": {
        "tags": [
          "Streetpay.API"
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OfflineTransactionDto": {
        "required": [
          "amount",
          "receiverPhone",
          "senderPhone",
          "timestamp",
          "transactionId"
        ],
        "type": "object",
        "properties": {
          "senderPhone": {
            "minLength": 1,
            "type": "string",
            "format": "tel"
          },
          "receiverPhone": {
            "minLength": 1,
            "type": "string",
            "format": "tel"
          },
          "amount": {
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "transactionId": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "senderNewBalance": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "receiverNewBalance": {
            "type": "number",
            "format": "double",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "OnlineTransactionDto": {
        "required": [
          "amount",
          "receiverId",
          "senderId",
          "transactionId"
        ],
        "type": "object",
        "properties": {
          "senderId": {
            "type": "integer",
            "format": "int32"
          },
          "receiverId": {
            "type": "integer",
            "format": "int32"
          },
          "amount": {
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "transactionId": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Transaction": {
        "required": [
          "amount",
          "receiverPhone",
          "senderPhone",
          "status",
          "transactionId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "transactionId": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "senderId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "receiverId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "senderPhone": {
            "minLength": 1,
            "type": "string",
            "format": "tel"
          },
          "receiverPhone": {
            "minLength": 1,
            "type": "string",
            "format": "tel"
          },
          "amount": {
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "senderNewBalance": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "receiverNewBalance": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "currency": {
            "maxLength": 3,
            "type": "string",
            "nullable": true
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "used": {
            "type": "boolean"
          },
          "type": {
            "maxLength": 20,
            "type": "string",
            "nullable": true
          },
          "status": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          },
          "isSynced": {
            "type": "boolean"
          },
          "signature": {
            "maxLength": 256,
            "type": "string",
            "nullable": true
          },
          "sender": {
            "$ref": "#/components/schemas/User"
          },
          "receiver": {
            "$ref": "#/components/schemas/User"
          }
        },
        "additionalProperties": false
      },
      "User": {
        "required": [
          "mainBalance",
          "name",
          "phone",
          "pin",
          "savingsBalance"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "phone": {
            "minLength": 1,
            "type": "string",
            "format": "tel"
          },
          "pin": {
            "minLength": 1,
            "type": "string"
          },
          "mainBalance": {
            "type": "number",
            "format": "double"
          },
          "savingsBalance": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "UserLoginRequest": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "nullable": true
          },
          "pin": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UserRegisterRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "pin": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "WalletUpdateRequest": {
        "required": [
          "main",
          "savings",
          "transactionId"
        ],
        "type": "object",
        "properties": {
          "main": {
            "type": "number",
            "format": "double"
          },
          "savings": {
            "type": "number",
            "format": "double"
          },
          "transactionId": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}